FROM tomcat:9-jdk11-openjdk

ARG DEFAULT_NAMESPACE
ARG EMAIL_PASSWORD
ARG EMAIL_PORT
ARG EMAIL_REPLY_TO
ARG EMAIL_SMTP_HOST
ARG EMAIL_USERNAME
ARG FORCE_LOCALE
ARG LANGUAGE_FILTER_ENABLED
ARG RECONFIGURE
ARG ROOT_USER_ADDRESS
ARG SAMPLE_DATA_BRANCH
ARG SAMPLE_DATA_DIRECTORY
ARG SAMPLE_DATA_LOAD
ARG SAMPLE_DATA_REPO_URL
ARG SEARCH_ENGINE_PASSWORD
ARG SEARCH_ENGINE_URL
ARG SEARCH_ENGINE_USERNAME
ARG SELECTABLE_LOCALES
ARG SELF_ID_MATCHING_PROPERTY
ARG SOLR_CONTAINER_PORT
ARG SOLR_CORES
ARG SOLR_HOST_PORT
ARG SOLR_RESET_CORE
ARG SOLR_URL
ARG SOLR_VERBOSE
ARG TOMCAT_CONTEXT_PATH
ARG VIVO_CONTAINER_PORT
ARG VIVO_CONTAINER_VIVO_HOME
ARG VIVO_HOST_PORT
ARG VIVO_HOST_VIVO_HOME
ARG VIVO_RESET_HOME
ARG VIVO_TDB_FILE_MODE
ARG VIVO_VERBOSE

ENV DEFAULT_NAMESPACE=${DEFAULT_NAMESPACE}
ENV EMAIL_PASSWORD=${EMAIL_PASSWORD}
ENV EMAIL_PORT=${EMAIL_PORT}
ENV EMAIL_REPLY_TO=${EMAIL_REPLY_TO}
ENV EMAIL_SMTP_HOST=${EMAIL_SMTP_HOST}
ENV EMAIL_USERNAME=${EMAIL_USERNAME}
ENV FORCE_LOCALE=${FORCE_LOCALE}
ENV LANGUAGE_FILTER_ENABLED=${LANGUAGE_FILTER_ENABLED}
ENV RECONFIGURE=${RECONFIGURE}
ENV ROOT_USER_ADDRESS=${ROOT_USER_ADDRESS}
ENV SAMPLE_DATA_BRANCH=${SAMPLE_DATA_BRANCH}
ENV SAMPLE_DATA_DIRECTORY=${SAMPLE_DATA_DIRECTORY}
ENV SAMPLE_DATA_LOAD=${SAMPLE_DATA_LOAD}
ENV SAMPLE_DATA_REPO_URL=${SAMPLE_DATA_REPO_URL}
ENV SEARCH_ENGINE_PASSWORD=${SEARCH_ENGINE_PASSWORD}
ENV SEARCH_ENGINE_URL=${SEARCH_ENGINE_URL}
ENV SEARCH_ENGINE_USERNAME=${SEARCH_ENGINE_USERNAME}
ENV SELECTABLE_LOCALES=${SELECTABLE_LOCALES}
ENV SELF_ID_MATCHING_PROPERTY=${SELF_ID_MATCHING_PROPERTY}
ENV SOLR_CONTAINER_PORT=${SOLR_CONTAINER_PORT}
ENV SOLR_CORES=${SOLR_CORES}
ENV SOLR_HOST_PORT=${SOLR_HOST_PORT}
ENV SOLR_RESET_CORE=${SOLR_RESET_CORE}
ENV SOLR_URL=${SOLR_URL}
ENV SOLR_VERBOSE=${SOLR_VERBOSE}
ENV TOMCAT_CONTEXT_PATH=${TOMCAT_CONTEXT_PATH}
ENV VIVO_CONTAINER_PORT=${VIVO_CONTAINER_PORT}
ENV VIVO_CONTAINER_VIVO_HOME=${VIVO_CONTAINER_VIVO_HOME}
ENV VIVO_HOST_PORT=${VIVO_HOST_PORT}
ENV VIVO_HOST_VIVO_HOME=${VIVO_HOST_VIVO_HOME}
ENV VIVO_RESET_HOME=${VIVO_RESET_HOME}
ENV VIVO_TDB_FILE_MODE=${VIVO_TDB_FILE_MODE}
ENV VIVO_VERBOSE=${VIVO_VERBOSE}

RUN mkdir -p ${VIVO_CONTAINER_VIVO_HOME}
RUN mkdir ${VIVO_HOST_VIVO_HOME}

# Copy VIVO home onto image for backup, initialization, and reset
COPY ./home/src/main/resources/config ${VIVO_HOST_VIVO_HOME}/config
COPY ./installer/webapp/target/vivo.war /usr/local/tomcat/webapps/ROOT.war

COPY start.sh /start.sh

EXPOSE 8080

CMD ["/bin/bash", "/start.sh"]
