# Copy this file to .env and adjust values for your runtime environment.

# Enable verbose shell logging in start.sh (yes/no)
# WARNING: Setting VERBOSE=yes can leak secrets to logs
VERBOSE=no

# Tomcat context name for first startup (alphanumeric _ . - allowed)
# ROOT deploys at / changing this after deployment requires recreating the container
TOMCAT_CONTEXT_PATH=ROOT

# Reset VIVO_HOME contents on container startup (true/false)
# WARNING: A container created with RESET_HOME=true will wipe $VIVO_HOME on every restart until recreated
VIVO_RESET_HOME=false

# Whether to reset runtime.properties and applicationSetup.n3 to example.* defaults on startup (true/false)
RECONFIGURE=false

# VIVO home directory inside the container
VIVO_CONTAINER_VIVO_HOME=/usr/local/vivo/home

# VIVO home directory on the host, created besides Docker Compose file
VIVO_HOST_VIVO_HOME=./vivo-home

# Apache Jena TDB file access mode (direct/mapped)
VIVO_TDB_FILE_MODE=direct

# Search engine configuration (type: solr/elasticsearch/opensearch url: http://vivo-solr:8983/solr/vivocore)
SEARCH_ENGINE_TYPE=solr
SEARCH_ENGINE_URL=http://vivo-solr:8983/solr/vivocore
SEARCH_ENGINE_USERNAME=
SEARCH_ENGINE_PASSWORD=

# Email settings (when non-empty, applied to runtime.properties on container startup)
EMAIL_SMTP_HOST=
EMAIL_PORT=
EMAIL_REPLY_TO=
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Root user email address (vivo_root@mydomain.edu)
ROOT_USER_ADDRESS=

# Default namespace (http://vivo.mydomain.edu/individual/)
DEFAULT_NAMESPACE=

# Individual property associated with user account (http://vivo.mydomain.edu/ns#networkId)
SELF_ID_MATCHING_PROPERTY=

# Enable language filter to respect browser Accept-Language header (true/false)
LANGUAGE_FILTER_ENABLED=

# Ignore browser Accept-Language header (en_US)
FORCE_LOCALE=

# Selectable locales as a comma separated list (en_US, es_GO)
SELECTABLE_LOCALES=

# Load sample data at container setup
SAMPLE_DATA_LOAD=false
SAMPLE_DATA_REPO_URL=https://raw.githubusercontent.com/vivo-project/sample-data/main/sample-data.n3
SAMPLE_DATA_BRANCH= # not implemented
SAMPLE_DATA_DIRECTORY= # not implemented

# Host and container ports for VIVO (Tomcat HTTP connector)
VIVO_HOST_PORT=8080
VIVO_CONTAINER_PORT=8080

# Reset VIVO Solr core when starting container (true/false)
SOLR_RESET_CORE=false

# Variable substitution for docker-compose.yml

# solr service variable substitution
#SOLR_RESET_CORE=false
SOLR_VERBOSE=no

SOLR_HOST_PORT=8983
SOLR_CONTAINER_PORT=8983

SOLR_CORES=./vivo-cores

# tomcat service variable substitution
#VIVO_RESET_HOME=false
VIVO_VERBOSE=no

#VIVO_TDB_FILE_MODE=direct

#VIVO_HOST_VIVO_HOME=./vivo-home
#VIVO_CONTAINER_VIVO_HOME=/usr/local/vivo/home

#VIVO_HOST_PORT=8080
#VIVO_CONTAINER_PORT=8080

JOAI_HOST_PORT=8082
JOAI_CONTAINER_PORT=8080

JOAI_HOST_HTTPS_PORT=8084
JOAI_CONTAINER_HTTPS_PORT=8443
JOAI_CONFIG_HOME=joai-config
JOAI_DATA_HOME=joai-data
